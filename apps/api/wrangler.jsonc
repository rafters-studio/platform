{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafters-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "rafters_platform",
      "database_name": "rafters_platform",
      "database_id": "141cae6b-a9c7-4e0e-96a8-522c08d8b0d9",
    },
  ],
  "routes": [
    {
      "pattern": "rafters.studio/api/*",
      "zone_name": "rafters.studio",
    },
  ],
}
