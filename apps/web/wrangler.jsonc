{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafters-studio-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "logpush": true,
  "placement": {
    "mode": "smart",
  },
  // Path-scoped route: shingle owns rafters.studio/* (apex marketing),
  // apps/ctrl will mount at rafters.studio/ctrl/*. Mirrors the rafters/apps/registry
  // topology -- never custom_domain at the apex when multiple workers coexist.
  "routes": [
    {
      "pattern": "rafters.studio/api/*",
      "zone_id": "142da5fc1cd70bb8bb80be9926f83750",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafters",
      "database_id": "cc61dd17-b939-4dbc-8ec8-347fb6b169b9",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "rafters_session",
      "id": "69119b2141ee4755b75a5e34364d1a2f",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *", "0 2 * * *"],
  },
  "vars": {
    "FROM_EMAIL": "noreply@rafters.studio",
  },
  // RESEND_API_KEY is provisioned via `wrangler secret put RESEND_API_KEY`.
  "r2_buckets": [
    {
      "bucket_name": "rafters-email",
      "binding": "rafters_email",
    },
    {
      "bucket_name": "rafters-logs",
      "binding": "rafters_logs",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rafters-color-vocab",
    },
  ],
  // The consumer seat moves here from rafters-api. CF allows one worker
  // consumer per queue: rafters-api must release the seat (worker deleted
  // or redeployed without its consumers block) before this deploys.
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "color-processing-queue" }],
    "consumers": [{ "queue": "color-processing-queue" }],
  },
}
