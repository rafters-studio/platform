{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafters-studio-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "logpush": true,
  "placement": {
    "mode": "smart",
  },
  "routes": [
    {
      "pattern": "rafters.studio",
      "zone_id": "142da5fc1cd70bb8bb80be9926f83750",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafters",
      "database_id": "cc61dd17-b939-4dbc-8ec8-347fb6b169b9",
      "migrations_dir": "src/db/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "rafters_session",
      "id": "69119b2141ee4755b75a5e34364d1a2f",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *", "0 2 * * *"],
  },
  // FROM_EMAIL and RESEND_API_KEY: add when wiring real OTP delivery
  "r2_buckets": [
    {
      "bucket_name": "rafters-email",
      "binding": "rafters_email",
    },
    {
      "bucket_name": "rafters-logs",
      "binding": "rafters_logs",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rafters-color-vocab",
    },
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "color-processing-queue" }],
  },
}
