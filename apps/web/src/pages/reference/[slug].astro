---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("reference");
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const entry = await getEntry("reference", slug!);
if (!entry) return Astro.redirect("/reference");
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} -- Rafters`} description={entry.data.description}>
  <main class="flex-1 max-w-prose mx-auto px-6 py-16">
    <nav class="mb-8">
      <a href="/reference" class="text-sm text-muted-foreground hover:underline">Reference</a>
    </nav>
    <article>
      <header class="mb-12">
        <h1 class="text-3xl mb-4">{entry.data.title}</h1>
        <p class="text-muted-foreground">{entry.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
</Layout>

<style is:global>
  .prose h2 {
    font-size: 1.375rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    font-size: 1.125rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose code {
    font-size: 0.875rem;
    background-color: var(--muted);
    padding: 0.125rem 0.375rem;
  }

  .prose pre {
    background-color: oklch(0.2 0 0);
    color: oklch(0.967 0 0);
    padding: 1rem;
    margin-bottom: 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 2px solid var(--border);
    padding-left: 1rem;
    margin-bottom: 1rem;
    color: var(--muted-foreground);
  }

  .prose table {
    width: 100%;
    margin-bottom: 1rem;
    font-size: 0.875rem;
  }

  .prose th {
    text-align: left;
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
    font-weight: 600;
  }

  .prose td {
    padding: 0.5rem 1rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .prose a {
    text-decoration: underline;
  }

  .prose sup a {
    text-decoration: none;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .prose section.footnotes {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
