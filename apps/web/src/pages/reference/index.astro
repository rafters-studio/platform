---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Base.astro";

const entries = await getCollection("reference");
const sorted = entries.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<Layout title="Reference -- Rafters">
  <main class="flex-1 max-w-prose mx-auto px-6 py-16">
    <h1 class="text-3xl mb-4">Reference</h1>
    <p class="text-muted-foreground mb-12">
      Deep dives into the design intelligence concepts behind Rafters.
      Not tutorials. Not API docs. The thinking.
    </p>

    <div class="flex flex-col gap-8">
      {sorted.map((entry) => (
        <a href={`/reference/${entry.id}`} class="group block">
          <h2 class="text-lg font-semibold mb-1 group-hover:underline">{entry.data.title}</h2>
          <p class="text-sm text-muted-foreground">{entry.data.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
