---
import Layout from "../layouts/Base.astro";
---

<Layout title="Studio - Rafters">
  <main class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight mb-6">Studio</h1>
    <p class="text-xl leading-relaxed mb-4">
      The visual editor for your design system rules. Coming soon.
    </p>
    <p class="text-lg leading-relaxed text-neutral-600">
      Configure spacing progressions, type scales, color relationships, and motion philosophy.
      Not a token picker. A rule editor that generates tokens from mathematical relationships.
    </p>
  </main>
</Layout>
