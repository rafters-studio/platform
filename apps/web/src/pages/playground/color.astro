---
import Layout from "../../layouts/Base.astro";
import ColorPlayground from "../../components/color-playground";
---

<Layout title="Color Intelligence Playground - Rafters">
  <main class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold tracking-tight mb-4">Color Intelligence</h1>
    <p class="text-lg leading-relaxed text-neutral-600 mb-8">
      Enter any CSS color. Get perceptual analysis in OKLCH, WCAG accessibility scoring,
      and harmonic relationships. All math, no guessing.
    </p>
    <ColorPlayground client:load />
  </main>
</Layout>
