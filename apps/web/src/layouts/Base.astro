---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900">
    <header class="border-b border-neutral-200">
      <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center gap-8">
        <a href="/" class="text-lg font-bold tracking-tight">Rafters</a>
        <div class="flex gap-6 text-sm">
          <a href="/docs" class="hover:underline">Docs</a>
          <a href="/reference" class="hover:underline">Reference</a>
          <a href="/studio" class="hover:underline">Studio</a>
          <a href="/api/docs" class="hover:underline">API</a>
        </div>
      </nav>
    </header>
    <slot />
    <footer class="border-t border-neutral-200 mt-16">
      <div class="max-w-5xl mx-auto px-6 py-8 text-sm text-neutral-500">
        <p>Rafters is open source. Built by ezmode games.</p>
      </div>
    </footer>
  </body>
</html>
