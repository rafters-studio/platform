{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafters-studio-web-smoke",
  "main": "src/api/test-worker.ts",
  "compatibility_date": "2026-03-17",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "rafters-color-vocab",
      "remote": true,
    },
  ],
}
