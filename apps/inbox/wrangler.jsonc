{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rafters-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "logpush": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rafters",
      "database_id": "cc61dd17-b939-4dbc-8ec8-347fb6b169b9",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "rafters-email",
      "binding": "rafters_email",
    },
    {
      "bucket_name": "rafters-logs",
      "binding": "rafters_logs",
    },
  ],
}
