{
  "name": "rafters-studio-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @rafters-studio/web dev",
    "build": "pnpm --filter @rafters-studio/web build",
    "test": "vitest run --config vitest.config.ts",
    "test:spec": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:spec && pnpm test:e2e",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ezmode-games/drizzle-ledger",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
